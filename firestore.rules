rules_version = '2';

// Deny everything. The site has no accounts or logins (HANDOFF decision 13). The intake form's
// server-side write comes in a later session and will use the Admin SDK, which skips these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
