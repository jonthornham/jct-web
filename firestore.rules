rules_version = '2';

// The site has no accounts or logins (HANDOFF decision 13). The only thing a browser may do is
// create one Free Consult request in `consults`: exact fields, length limits, the server's
// timestamp, one of the five stages, and an optional https:// link. No reads, updates or
// deletes. Everything else is denied.
//
// The limits match src/lib/intake.js (LIMITS, STAGES); tests/rules/consults.test.js checks both.
// The Cloud Function (functions/) uses the Admin SDK, which skips these rules, to add
// emailedAt or emailError after sending the email.
service cloud.firestore {
  match /databases/{database}/documents {

    function text(v, max) {
      return v is string && v.size() <= max && v.trim().size() > 0;
    }

    function isConsult(d) {
      return d.keys().hasAll(['name', 'email', 'company', 'stage', 'blocker', 'createdAt'])
        && d.keys().hasOnly(['name', 'email', 'company', 'stage', 'blocker', 'link', 'createdAt'])
        && text(d.name, 100)
        && text(d.email, 254) && d.email.matches('[^\\s@]+@[^\\s@]+[.][^\\s@]+')
        && text(d.company, 120)
        && d.stage in ['Idea', 'Prototype', 'Sampling', 'In production', 'Launched']
        && text(d.blocker, 2000)
        && (!('link' in d) || (text(d.link, 500) && d.link.matches('https://[^\\s]+')))
        && d.createdAt == request.time;
    }

    match /consults/{id} {
      allow create: if isConsult(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
