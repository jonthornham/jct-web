{
	"name": "jct-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "svelte-kit sync && vite dev --port 35173 --strictPort",
		"dev:preview": "PUBLIC_SHOW_PLACEHOLDERS=true npm run dev",
		"build": "svelte-kit sync && vite build",
		"build:preview": "PUBLIC_SHOW_PLACEHOLDERS=true npm run build",
		"preview": "vite preview --port 34173 --strictPort",
		"check": "npm run check:code && npm run check:placeholders",
		"check:placeholders": "node scripts/check-placeholders.mjs",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "node --test 'tests/unit/*.test.js'",
		"images": "node scripts/images.mjs",
		"screenshots": "node scripts/screenshots.mjs",
		"emulators": "firebase emulators:start --only firestore --project demo-jct",
		"test:seo": "PUBLIC_SHOW_PLACEHOLDERS=true vite build && node --test 'tests/seo/*.test.js' && node scripts/check-links.mjs",
		"check:links": "node scripts/check-links.mjs",
		"lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
		"check:code": "svelte-kit sync && svelte-check && node --test tests/unit/labels.test.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^5.5.1",
		"@sveltejs/kit": "^2.15.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"autoprefixer": "^10.4.20",
		"eslint": "^8.57.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"mdsvex": "^0.12.3",
		"playwright-core": "^1.48.2",
		"postcss": "^8.4.49",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.3.2",
		"prettier-plugin-tailwindcss": "^0.6.9",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.0",
		"sharp": "^0.33.5",
		"svelte": "^5.16.6",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3",
		"vite": "^6.0.7"
	},
	"dependencies": {
		"@tailwindcss/forms": "^0.5.11",
		"bits-ui": "^2.15.5"
	},
	"engines": {
		"node": ">=24 <25"
	}
}
