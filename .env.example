# Copy to .env and fill in. Anything prefixed PUBLIC_ or VITE_ is bundled into the browser, so
# never put a secret in one of those. .env is never committed.

# true: show the [PLACEHOLDER] chips and striped image slots (preview builds and local dev).
# Anything else hides them, and `npm run build` then FAILS if any placeholder is left in src/.
# On Vercel: set it to true for Preview only, never for Production.
PUBLIC_SHOW_PLACEHOLDERS=true

# Firebase web config for jct-web-d8780 (Firebase console › Project settings › Your apps).
# Not secret (they ship in the page), but set on Vercel, not committed with values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise) site key. Empty: App Check doesn't start.
VITE_APPCHECK_SITE_KEY=

# Local only: true makes a built site (vite build / preview) use the emulators (demo-jct).
# `npm run dev` always uses the emulators, whatever this says. Never set it on Vercel.
VITE_USE_FIREBASE_EMULATORS=
